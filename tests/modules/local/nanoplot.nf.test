nextflow_process {

    name "Test NANOPLOT"
    script "../../../modules/local/nanoplot.nf"
    process "NANOPLOT"
    tag "nanoplot"
    options "-stub"

    test("ONT reads - stub") {
        when {
            process {
                """
                input[0] = [ [id: 'L1', mode: 'long'], file("${projectDir}/tests/data/stub/long_ont.fastq.gz", checkIfExists: true) ]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.stats, process.out.versions_nanoplot).match() }
            )
        }
    }
}
