#!/usr/bin/env python3
"""staphit-cgmlst-schema: download a PubMLST cgMLST scheme as one allele FASTA per locus.

    staphit-cgmlst-schema -o schema_fasta [--db pubmlst_saureus_seqdef] [--scheme 20]

Default: S. aureus cgMLST (PubMLST scheme 20, 1,716 loci). The directory is the input of
`chewBBACA.py PrepExternalSchema`. Unauthenticated access returns alleles defined up to
PubMLST's public cut-off date, which is enough for allele calling (new alleles are inferred).
"""
import argparse
import concurrent.futures
import json
import os
import sys
import time
import urllib.request

API = 'https://rest.pubmlst.org/db'


def get(url, tries=5):
    for attempt in range(tries):
        try:
            with urllib.request.urlopen(url, timeout=120) as r:
                return r.read()
        except Exception as e:  # network blips / rate limiting: back off and retry
            if attempt == tries - 1:
                raise RuntimeError(f'{url}: {e}')
            time.sleep(2 ** attempt)


def fetch_locus(url, outdir):
    name = url.rstrip('/').split('/')[-1]
    path = os.path.join(outdir, f'{name}.fasta')
    if not os.path.exists(path):
        data = get(f'{url}/alleles_fasta')
        if not data.startswith(b'>'):
            raise RuntimeError(f'{name}: not a FASTA response')
        with open(path + '.tmp', 'wb') as fh:
            fh.write(data)
        os.replace(path + '.tmp', path)
    return name


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument('-o', '--outdir', required=True)
    ap.add_argument('--db', default='pubmlst_saureus_seqdef')
    ap.add_argument('--scheme', type=int, default=20)
    ap.add_argument('--threads', type=int, default=4, help='parallel downloads (be polite to PubMLST)')
    a = ap.parse_args(argv)

    scheme = json.loads(get(f'{API}/{a.db}/schemes/{a.scheme}'))
    loci = scheme['loci']
    print(f"{a.db} scheme {a.scheme} ({scheme['description']}): {len(loci)} loci", file=sys.stderr)
    os.makedirs(a.outdir, exist_ok=True)
    with concurrent.futures.ThreadPoolExecutor(a.threads) as pool:
        for i, _ in enumerate(pool.map(lambda u: fetch_locus(u, a.outdir), loci), 1):
            if i % 200 == 0:
                print(f'  {i}/{len(loci)}', file=sys.stderr)
    got = sum(1 for f in os.listdir(a.outdir) if f.endswith('.fasta'))
    if got != len(loci):
        sys.exit(f'ERROR: {got} of {len(loci)} loci downloaded')
    print(f'Downloaded {got} loci', file=sys.stderr)


if __name__ == '__main__':
    main()
