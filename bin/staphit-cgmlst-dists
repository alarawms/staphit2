#!/usr/bin/env python3
"""staphit-cgmlst-dists: pairwise allele differences from a chewBBACA allele matrix.

    staphit-cgmlst-dists results_alleles.tsv cgmlst_distances.tsv cgmlst_stats.tsv

Distance = loci where both samples have an allele call and the alleles differ
(missing loci are ignored pair by pair, as in SeqSphere+/PubMLST). INF-<n> calls are new
alleles inferred in this run; chewBBACA numbers them consistently within one AlleleCall
run, so all samples must be called together. Everything that is not a number (LNF,
PLOT3/5, LOTSC, NIPH, NIPHEM, ALM, ASM, PAMA) counts as missing.

Distances: square TSV in snp-dists layout. Stats: sample_id, called_loci, missing_loci, total_loci.
"""
import argparse

import numpy as np


def read_profiles(path):
    """-> (sample ids, int matrix samples x loci with 0 = missing, n loci)"""
    ids, rows = [], []
    with open(path) as fh:
        loci = fh.readline().rstrip('\n').split('\t')[1:]
        for line in fh:
            parts = line.rstrip('\n').split('\t')
            name = parts[0]
            for ext in ('.fasta', '.fna', '.fa'):
                if name.endswith(ext):
                    name = name[:-len(ext)]
            ids.append(name)
            rows.append([_allele(v) for v in parts[1:]])
    return ids, np.array(rows, dtype=np.int64).reshape(len(ids), len(loci)), len(loci)


def _allele(value):
    value = value[4:] if value.startswith('INF-') else value
    return int(value) if value.isdigit() else 0


def distances(m):
    called = m > 0
    d = np.zeros((len(m), len(m)), dtype=np.int64)
    for i in range(len(m)):
        d[i] = ((m != m[i]) & called & called[i]).sum(axis=1)
    return d


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument('profiles')
    ap.add_argument('distances')
    ap.add_argument('stats')
    a = ap.parse_args(argv)

    ids, m, n_loci = read_profiles(a.profiles)
    d = distances(m)
    with open(a.distances, 'w') as fh:
        fh.write('cgmlst-dists\t' + '\t'.join(ids) + '\n')
        for sid, row in zip(ids, d):
            fh.write(sid + '\t' + '\t'.join(map(str, row)) + '\n')
    with open(a.stats, 'w') as fh:
        fh.write('sample_id\tcalled_loci\tmissing_loci\ttotal_loci\n')
        for sid, n in zip(ids, (m > 0).sum(axis=1)):
            fh.write(f'{sid}\t{n}\t{n_loci - n}\t{n_loci}\n')


if __name__ == '__main__':
    main()
