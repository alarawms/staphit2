#!/usr/bin/env python3
"""Staphit Surveillance Dashboard."""
import argparse
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
from dashboard.data_loader import load_all
from dashboard.app import create_app


def main():
    parser = argparse.ArgumentParser(description="Staphit Surveillance Dashboard")
    parser.add_argument("results_dir", help="Pipeline results directory")
    parser.add_argument("--metadata", help="sample_metadata.csv")
    parser.add_argument("--antibiogram", help="antibiogram.csv")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8050)
    args = parser.parse_args()

    data = load_all(args.results_dir, args.metadata, args.antibiogram)
    app = create_app(data)
    print(f"Dashboard: http://{args.host}:{args.port}", file=sys.stderr)
    app.run(host=args.host, port=args.port, debug=False)


if __name__ == "__main__":
    main()
