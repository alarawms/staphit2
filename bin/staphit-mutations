#!/usr/bin/env python3
"""staphit-mutations: profile point mutations from AMRFinderPlus output."""
import argparse
import csv
import json
import sys
from collections import defaultdict

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

_CLASS_MAP = {
    'QUINOLONE': 'Fluoroquinolones',
    'RIFAMYCIN': 'Rifampicin',
    'RIFAMPICIN': 'Rifampicin',
    'FUSIDIC ACID': 'Fusidic Acid',
    'FOSFOMYCIN': 'Fosfomycin',
    'MUPIROCIN': 'Mupirocin',
    'TETRACYCLINE': 'Tetracycline',
    'TRIMETHOPRIM': 'Trimethoprim',
    'SULFONAMIDE': 'Sulfonamide',
    'LINCOSAMIDE': 'Lincosamide',
    'OXAZOLIDINONE': 'Linezolid',
    'PHENICOL': 'Phenicol',
    'BETA-LACTAM': 'Beta-lactam',
}

_CLASS_TO_ANTIBIOTICS = {
    'Fluoroquinolones': ['Levofloxacin', 'Moxifloxacin', 'Ciprofloxacin'],
    'Rifampicin': ['Rifampicin'],
    'Fusidic Acid': ['Fusidic Acid'],
    'Fosfomycin': ['Fosfomycin'],
    'Mupirocin': ['Mupirocin'],
    'Tetracycline': ['Tetracycline', 'Doxycycline', 'Tigecycline'],
    'Trimethoprim': ['Trimethoprim/Sulfamethoxazole'],
    'Sulfonamide': ['Trimethoprim/Sulfamethoxazole'],
    'Linezolid': ['Linezolid'],
    'Phenicol': ['Chloramphenicol'],
    'Beta-lactam': ['Oxacillin', 'Benzylpenicillin'],
    'Lincosamide': ['Clindamycin'],
}

# ---------------------------------------------------------------------------
# Core functions
# ---------------------------------------------------------------------------


def parse_amrfinder_mutations(tsv_path):
    """Read AMRFinderPlus TSV, filter POINT rows, return list of mutation dicts."""
    mutations = []
    with open(tsv_path, newline='') as fh:
        reader = csv.DictReader(fh, delimiter='\t')
        for row in reader:
            if row.get('Subtype') != 'POINT':
                continue
            symbol = row['Element symbol']
            # Split on first underscore: gene_mutation
            parts = symbol.split('_', 1)
            if len(parts) != 2:
                continue
            gene, mutation = parts
            raw_class = row.get('Class', '').upper()
            drug_class = _CLASS_MAP.get(raw_class, raw_class)
            mutations.append({
                'gene': gene,
                'mutation': mutation,
                'drug_class': drug_class,
            })
    return mutations


def classify_mutations(mutations):
    """Group mutations by drug_class. Return dict of class -> list."""
    if not mutations:
        return {}
    grouped = defaultdict(list)
    for m in mutations:
        grouped[m['drug_class']].append(m)
    return dict(grouped)


def predict_phenotype(mutations):
    """Any POINT mutation predicts R for its class. Return dict of class -> 'R'."""
    if not mutations:
        return {}
    predictions = {}
    for m in mutations:
        predictions[m['drug_class']] = 'R'
    return predictions


def compare_genotype_phenotype(predictions, antibiogram):
    """Compare genotypic predictions with phenotypic antibiogram.

    Parameters
    ----------
    predictions : dict
        class -> predicted SIR (e.g. 'R').
    antibiogram : list of dict
        Each dict has 'antibiotic' and 'sir' keys.

    Returns
    -------
    dict
        class -> {genotype, phenotype, concordant}
    """
    if not predictions or not antibiogram:
        return {}

    # Build lookup: antibiotic name -> SIR
    abg_lookup = {}
    for entry in antibiogram:
        abg_lookup[entry['antibiotic']] = entry['sir']

    result = {}
    for drug_class, predicted_sir in predictions.items():
        antibiotics = _CLASS_TO_ANTIBIOTICS.get(drug_class, [])
        matching_sirs = [abg_lookup[ab] for ab in antibiotics if ab in abg_lookup]
        if not matching_sirs:
            continue
        concordant = any(s == predicted_sir for s in matching_sirs)
        result[drug_class] = {
            'genotype': predicted_sir,
            'phenotype': matching_sirs[0],
            'concordant': concordant,
        }
    return result


def format_mutation_summary(mutations):
    """Semicolon-joined 'gene:mutation' pairs."""
    if not mutations:
        return ''
    return ';'.join(f"{m['gene']}:{m['mutation']}" for m in mutations)


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------


def main():
    parser = argparse.ArgumentParser(
        description='Profile point mutations from AMRFinderPlus output',
    )
    parser.add_argument('amrfinder_tsv', help='AMRFinderPlus TSV output')
    parser.add_argument('-o', '--output', help='Output JSON path (default: stdout)')
    parser.add_argument(
        '--antibiogram',
        help='Path to JSON antibiogram (list of {antibiotic, sir} dicts)',
    )
    args = parser.parse_args()

    mutations = parse_amrfinder_mutations(args.amrfinder_tsv)
    classified = classify_mutations(mutations)
    predictions = predict_phenotype(mutations)
    summary = format_mutation_summary(mutations)

    output = {
        'mutations': mutations,
        'classified': classified,
        'predictions': predictions,
        'summary': summary,
    }

    if args.antibiogram:
        with open(args.antibiogram) as fh:
            antibiogram = json.load(fh)
        output['concordance'] = compare_genotype_phenotype(predictions, antibiogram)

    json_str = json.dumps(output, indent=2)

    if args.output:
        with open(args.output, 'w') as fh:
            fh.write(json_str + '\n')
    else:
        print(json_str)


if __name__ == '__main__':
    main()
