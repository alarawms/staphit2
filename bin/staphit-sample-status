#!/usr/bin/env python3
"""staphit-sample-status: say what happened to every input sample.

Each sample is followed through the pipeline stages; the first stage it is missing from
is why it was dropped. Stages (in order) come from --stages, a TSV of `stage<TAB>sample_id`
lines written by the workflow:

    input        every samplesheet row
    assembled    the assembler produced contigs           (else: assembly_failed)
    size_pass    assembly >= 500 kb                       (else: assembly_too_small)
    qc_pass      passed the CheckM2 QC gate               (else: qc_gate_failed)
    species_pass confirmed S. aureus by fastANI           (else: not_s_aureus)

then the run-level outputs:

    summary      row in combined_summary.tsv              (else: typing_incomplete)
    tree         tip in the phylogeny                     (else: not_in_tree; still in the summary)

`size<TAB>sample_id<TAB>bytes` lines give the assembly size for the size reason.
Detail files named NO_* are placeholders for skipped steps and are ignored.

Output TSV: sample_id, status (included | not_in_tree | dropped), stage, reason
"""
import argparse
import csv
import os
import re
import sys

STAGES = [
    ('assembled', 'assembly_failed'),
    ('size_pass', 'assembly_too_small'),
    ('qc_pass', 'qc_gate_failed'),
    ('species_pass', 'not_s_aureus'),
]


def _given(path):
    return path and not os.path.basename(path).startswith('NO_') and os.path.exists(path)


def _rows(path):
    if not _given(path):
        return {}
    with open(path, newline='') as fh:
        return {r['sample_id']: r for r in csv.DictReader(fh, delimiter='\t')}


def read_stages(path):
    seen, sizes, order = {}, {}, []
    with open(path) as fh:
        for line in fh:
            parts = line.rstrip('\n').split('\t')
            if len(parts) < 2 or not parts[1]:
                continue
            stage, sid = parts[0], parts[1]
            if stage == 'size':
                sizes[sid] = int(parts[2])
                continue
            seen.setdefault(stage, set()).add(sid)
            if stage == 'input' and sid not in order:
                order.append(sid)
    return seen, sizes, order


def tree_tips(path):
    if not _given(path):
        return None
    text = open(path).read()
    return set(re.findall(r'[(,]\s*([^():,;\s]+)', text))


def classify(sid, seen, sizes, qc, species, summary, tips):
    for stage, label in STAGES:
        if sid in seen.get(stage, set()):
            continue
        if label == 'assembly_failed':
            why = 'assembler produced no contigs (low depth, wrong read type, or tool error; see the assembler log)'
        elif label == 'assembly_too_small':
            size = sizes.get(sid, 0)
            why = 'assembly is empty (no contigs)' if size == 0 else f"assembly {size / 1e6:.2f} MB < 0.5 MB"
        elif label == 'qc_gate_failed':
            r = qc.get(sid, {})
            why = r.get('reason') or f"completeness {r.get('completeness', '?')}%, contamination {r.get('contamination', '?')}%"
        else:
            r = species.get(sid, {})
            why = f"ANI to NCTC 8325 {r.get('ani_percent', '?')}%; best Mash hit: {r.get('identified_species', 'unknown')}"
        return 'dropped', label, why
    if sid not in summary:
        return 'dropped', 'typing_incomplete', 'missing from the summary (a typing/AMR step failed; check the run log)'
    if tips is not None and sid not in tips:
        return 'not_in_tree', 'not_in_tree', 'in the summary but excluded from the phylogeny (Snippy failure or >80% unaligned, or Panaroo <500 CDS)'
    return 'included', '', ''


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument('--stages', required=True)
    ap.add_argument('--qc')
    ap.add_argument('--species-excluded')
    ap.add_argument('--summary', required=True)
    ap.add_argument('--tree')
    ap.add_argument('-o', '--output', required=True)
    a = ap.parse_args(argv)

    seen, sizes, order = read_stages(a.stages)
    qc, species, summary = _rows(a.qc), _rows(a.species_excluded), _rows(a.summary)
    tips = tree_tips(a.tree)
    counts = {}
    with open(a.output, 'w', newline='') as fh:
        w = csv.writer(fh, delimiter='\t')
        w.writerow(['sample_id', 'status', 'stage', 'reason'])
        for sid in order:
            status, stage, why = classify(sid, seen, sizes, qc, species, summary, tips)
            counts[status] = counts.get(status, 0) + 1
            w.writerow([sid, status, stage, why])
    print('Sample status: ' + ', '.join(f'{k} {v}' for k, v in sorted(counts.items())), file=sys.stderr)


if __name__ == '__main__':
    main()
