/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: SPADES {
        errorStrategy = 'ignore'
    }

    withName: SKESA {
        errorStrategy = 'ignore'
    }

    withName: DRAGONFLYE {
        errorStrategy = 'ignore'   // low-coverage ONT samples can fail Flye; drop them, don't kill the run
    }

    withName: 'AMRFINDERPLUS_RUN' {
        publishDir = [
            path: { "${params.outdir}/amrfinderplus" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'IQTREE' {
        // GTR+G4: avoids ModelFinder's 484-model sweep (~days on 665-taxon 2M-col alignments)
        // -safe: log-space arithmetic needed — patterns 76054/153709 genuinely underflow
        // -bb 1000 ultrafast bootstraps; -nm 200 caps NNI (converges by ~150 on this dataset)
        ext.args = '-m GTR+G4 -bb 1000 -nm 200 -safe'
        cpus   = { 32 * task.attempt }
        memory = { 96.GB * task.attempt }
        time   = { 96.h * task.attempt }
    }

    withName: 'FASTANI' {
        container = 'docker.io/staphb/fastani:1.34'
        publishDir = [
            path: { "${params.outdir}/species_qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MASH_SCREEN' {
        ext.args = '-i 0.9'
        publishDir = [
            path: { "${params.outdir}/species_qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CHECKM2' {
        // DIAMOND against uniref100.KO needs ~12 GB for block-size 2.0 plus overhead
        memory = { 48.GB * task.attempt }
    }

    withName: 'FASTP' {
        // Replaces Trim Galore, which deadlocks (cutadapt blocked on a full stderr pipe)
        // when the user exceeds fs.pipe-user-pages-soft and pipes shrink to 4-8 KB.
        maxRetries    = 2
        cpus          = 4
        memory        = { 8.GB * task.attempt }
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' :
                          task.attempt < 3 ? 'retry' : 'finish' }
    }

    // ── Local modules: publishing ──────────────────────────────────────────
    // Default above publishes to <outdir>/<first word of the process name>; only exceptions are listed.
    withName: 'AGGREGATOR'        { publishDir = [ path: { "${params.outdir}/aggregated" },  mode: params.publish_dir_mode ] }
    withName: 'CHEWBBACA_PREP'    { publishDir = [ path: { "${params.outdir}/cgmlst/schema" }, mode: params.publish_dir_mode ] }
    withName: 'CHEWBBACA_JOIN|CGMLST_DISTS' {
        publishDir = [ path: { "${params.outdir}/cgmlst" }, mode: params.publish_dir_mode ]
    }
    withName: 'DRAGONFLYE' {
        publishDir = [ path: { "${params.outdir}/dragonflye/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.{log,gfa}' ]
    }
    withName: 'FASTP'             { publishDir = [ path: { "${params.outdir}/fastp" }, mode: params.publish_dir_mode, pattern: '*.{json,html}' ] }
    withName: 'ITOL_EXPORT'       { publishDir = [ path: { params.outdir }, mode: params.publish_dir_mode ] }   // outputs are itol/*
    withName: 'NANOPLOT'          { publishDir = [ path: { "${params.outdir}/nanoplot/${meta.id}" }, mode: params.publish_dir_mode ] }
    withName: 'OUTBREAK_CLUSTER'  { publishDir = [ path: { "${params.outdir}/clusters" },   mode: params.publish_dir_mode ] }
    withName: 'PLASMID_SUMMARY'   { publishDir = [ path: { "${params.outdir}/plasmids" },   mode: params.publish_dir_mode ] }
    withName: 'PLOT_TREE'         { publishDir = [ path: { "${params.outdir}/phylogeny" },  mode: params.publish_dir_mode, pattern: '*.{pdf,svg}' ] }
    withName: 'QC_GATE'           { publishDir = [ path: { "${params.outdir}/qc_gate" },    mode: params.publish_dir_mode ] }
    withName: 'SAMPLE_STATUS' {
        // sample_status.tsv -> report/; the summary with qc_flags replaces SUMMARY_MERGER's copy in summary/
        publishDir = [ path: { params.outdir }, mode: params.publish_dir_mode,
                       saveAs: { f -> f == 'combined_summary.tsv' ? "summary/${f}" : f == 'sample_status.tsv' ? "report/${f}" : null } ]
    }
    withName: 'SCCMEC'            { publishDir = [ path: { "${params.outdir}/sccmec/${meta.id}" }, mode: params.publish_dir_mode ] }
    withName: 'SNIPPY'            { publishDir = [ path: { "${params.outdir}/snippy/${meta.id}" }, mode: params.publish_dir_mode ] }
    withName: 'SNIPPY_CORE'       { publishDir = [ path: { "${params.outdir}/snippy_core" },  mode: params.publish_dir_mode ] }
    withName: 'SPECIES_REPORT'    { publishDir = [ path: { "${params.outdir}/species_qc" },   mode: params.publish_dir_mode ] }
    withName: 'SUMMARY_MERGER'    { publishDir = [ enabled: false ] }   // published by SAMPLE_STATUS with qc_flags added
    withName: 'VALIDATE_METADATA' { publishDir = [ path: { "${params.outdir}/metadata" },     mode: params.publish_dir_mode ] }
    withName: 'VISUALIZATION'     { publishDir = [ path: { "${params.outdir}/figures" },      mode: params.publish_dir_mode ] }

    // ── Databases: published once to <outdir>/databases/<db>; reuse with --checkm2_db / --amrfinder_db / --mash_db ──
    withName: 'CHECKM2_DB'           { publishDir = [ path: { "${params.outdir}/databases/checkm2" },       mode: params.publish_dir_mode ] }
    withName: 'MASH_REFSEQ_DB'       { publishDir = [ path: { "${params.outdir}/databases/mash_refseq" },   mode: params.publish_dir_mode ] }
    withName: 'MOB_INIT'             { publishDir = [ path: { "${params.outdir}/databases/mob_suite" },     mode: params.publish_dir_mode ] }
    withName: 'AMRFINDERPLUS_UPDATE' { publishDir = [ path: { "${params.outdir}/databases/amrfinderplus" }, mode: params.publish_dir_mode ] }
    withName: 'FETCH_RESFINDER_DB'   { publishDir = [ path: { "${params.outdir}/databases/resfinder" },     mode: params.publish_dir_mode ] }

    // ── Local modules: error handling ──────────────────────────────────────
    // Per-sample failures that should drop the sample, not stop the run
    withName: 'MOB_RECON|PANAROO|PLOT_TREE|SNIPPY|SRA_FETCH' {
        errorStrategy = 'ignore'
    }
    withName: 'AGR_TYPING' {
        errorStrategy = { task.exitStatus in [125, 137] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }

}
