/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run alarawms/staphit2 -profile test,docker --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '6.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal real dataset: 2 short, 1 hybrid, 1 long-only S. aureus (ST5, ST8, ST1535), short reads 40x, ONT 20x'

    // Reads and samplesheet: https://github.com/alarawms/staphit2-test-data
    input = 'https://raw.githubusercontent.com/alarawms/staphit2-test-data/main/samplesheet.csv'

    // Skip the large database downloads (CheckM2 ~3 GB, Mash RefSeq ~1 GB)
    skip_qc_gate    = true
    skip_species_qc = true

    genome_size     = 2800000
    target_depth    = 40
}
